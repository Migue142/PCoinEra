# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/

# Visual Studio / Rider
.vs/
.vscode/

*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity cache
[Bb]ee/
[Dd]ebug*/
[Rr]ecordings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Crash reports
sysinfo.txt

# Generated IDE metadata
.idea/

# Addressables
ServerData/

# Build outputs
*.apk
*.aab
*.app
*.exe
*.ipa

# Unity autosaves
*.bak

# JetBrains Rider
*.DotSettings.user
